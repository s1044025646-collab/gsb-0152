{
  "name": "poly-real-root-isolator",
  "version": "1.0.0",
  "private": true,
  "description": "Exact rational-coefficient polynomial real-root isolation and sign interval backend",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite src/main.ts serve",
    "demo": "node --experimental-sqlite src/main.ts demo --run",
    "test": "node --experimental-sqlite --test test/*.test.ts",
    "clean": "node scripts/clean.mjs",
    "serve:managed": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
